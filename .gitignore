# --- Dependencias de Node (Fundamentales) ---
# Ignora las carpetas de librerías de ambos proyectos (front y back)
node_modules/
dist/
tmp/
out-tsc/
bazel-out/

# --- Angular (Cosas específicas) ---
.angular/
.browserslistrc
# Archivos de caché de compilación
.sass-cache/

# --- Backend & Variables de Entorno (CRÍTICO) ---
# Nunca subas tus contraseñas de la base de datos a Git
.env
.env.local
.env.*.local

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# --- Base de Datos & Docker ---
# Si usas Docker para PostgreSQL, esto evita subir los datos reales
.docker/
docker-volumes/
pgdata/

# --- Editores de Código ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Sistema Operativo ---
DS_Store
Thumbs.db